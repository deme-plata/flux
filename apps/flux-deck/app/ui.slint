    background: #1e1e2e;
    default-font-size: 16px;
    default-font-family: "Inter";
    in-out property <string> plan_goals: "◍ GOAL POSTS\n  ○ ship zone-shell\n  ○ wire live feeds\n  ○ The Pulse demo";
