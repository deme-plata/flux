// FCX — a constrained TSX dialect. Authored like Vite/TS, compiled to native
// Slint by flux-fcx (no Chromium, no bundled JS runtime).
export function Counter() {
  const [count, setCount] = useState(0);
  return (
    <vbox>
      <text>Count: {count}</text>
      <button onClick={() => setCount(count + 1)}>Increment</button>
    </vbox>
  );
}
