// HINT: See also -Z dump-mir for MIR at specific points during compilation.
fn sum_to(_1: i64) -> i64 {
    debug n => _1;
    let mut _0: i64;
    let mut _2: i64;
    let mut _4: bool;
    let mut _5: i64;
    let mut _6: i64;
    let mut _7: (i64, bool);
    let mut _8: (i64, bool);
    scope 1 {
        debug acc => _2;
        let mut _3: i64;
        scope 2 {
            debug i => _3;
        }
    }

    bb0: {
        _2 = const 0_i64;
        _3 = const 0_i64;
        goto -> bb1;
    }

    bb1: {
        _5 = copy _3;
        _4 = Lt(move _5, copy _1);
        switchInt(move _4) -> [0: bb5, otherwise: bb2];
    }

    bb2: {
        _6 = copy _3;
        _7 = AddWithOverflow(copy _2, copy _6);
        assert(!move (_7.1: bool), "attempt to compute `{} + {}`, which would overflow", copy _2, move _6) -> [success: bb3, unwind continue];
    }

    bb3: {
        _2 = move (_7.0: i64);
        _8 = AddWithOverflow(copy _3, const 1_i64);
        assert(!move (_8.1: bool), "attempt to compute `{} + {}`, which would overflow", copy _3, const 1_i64) -> [success: bb4, unwind continue];
    }

    bb4: {
        _3 = move (_8.0: i64);
        goto -> bb1;
    }

    bb5: {
        _0 = copy _2;
        return;
    }
}
