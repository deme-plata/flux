    in-out property <string> t3: "┌─ LANE C · CLAUDE CODE ─┐\n flux-dev skills\n└──────────────┘";
    in-out property <string> t4: "┌─ LANE D · CLAUDE CODE ─┐\n flux-dev skills\n└──────────────┘";
    in-out property <string> gpu_ticker: "▐ GPU-MARKET ▌ idle · no compute rented · +10% red-line ready";
    in-out property <string> m_chains: "● CHAINS\n  SIGIL  ✓\n  Quillon ✓";
    in-out property <string> m_boxes: "● BOXES\n  eps ✓ beta ✓\n  delta ✓ gamma ✓";
    in-out property <string> m_agents: "● AGENTS\n  rocky · codex\n  adrian";
    in-out property <string> m_gate: "┌ TWO-MIND GATE ┐\n 🟢 SAFE  $0.0000\n qwen→deepseek\n└──────────────┘";
    in-out property <string> status: "flux-deck v0.13 — PLAN · CONQUER · MASTER cockpit";
    in-out property <string> ticker: "💬 Claude: ready — hit ▶ Pulse for the 10-second showcase";
    in-out property <string> loginlink: "✅ logged in · paste a token in 🔑 · browser opens automatically when Claude needs login";
    in-out property <bool> master: true;
    in-out property <int> target: 1;
    callback autopilot(string);
    callback deploy(string);
    callback download(string);
    callback freshlogin(string);
    callback heal(string);
    callback login(string);
    callback navkey(string);
    callback openlink(string);
    callback pause(string);
    callback plannew(string);
    callback pulse(string);
    callback relay(string);
    callback shell(string);
    callback snapshot(string);
    callback updatenow(string);
    callback upload(string);
    VerticalBox {
        HorizontalBox {
            Button {
                text: "☰";
                clicked => { master = !master; }
            }
            Text {
                text: "⬡ FLUX DECK · PLAN · CONQUER · MASTER";
                color: #cdd6f4;
            }
            Button {
                text: "▶ Pulse";
                clicked => { pulse(""); }
            }
            Button {
                text: "✅ Auto-yes";
                clicked => { autopilot(""); }
            }
            Button {
                text: "🔑 Login";
                clicked => { login(""); }
            }
            Button {
                text: "🔗 Open login";
                clicked => { openlink(""); }
            }
            Button {
                text: "🔓 Fresh login";
                clicked => { freshlogin(""); }
            }
            Button {
                text: "⬆ Update";
                clicked => { updatenow(""); }
            }
        }
        HorizontalBox {
            Text {
                text: "\{loginlink}";
                color: #cdd6f4;
            }
        }
        HorizontalBox {
            Text {
                text: "⌨ keys → Lane \{target}";
                color: #cdd6f4;
            }
            Button {
                text: "A";
                clicked => { target = 1; }
            }
            Button {
                text: "B";
                clicked => { target = 2; }
            }
            Button {
                text: "C";
                clicked => { target = 3; }
            }
            Button {
                text: "D";
                clicked => { target = 4; }
            }
            Button {
                text: "↑";
                clicked => { navkey("up"); }
            }
            Button {
                text: "↓";
                clicked => { navkey("down"); }
            }
            Button {
                text: "⏎ Enter";
                clicked => { navkey("enter"); }
            }
            Button {
                text: "Esc";
                clicked => { navkey("esc"); }
            }
            Button {
                text: "✅ Yes";
                clicked => { navkey("yes"); }
            }
            Button {
                text: "❌ No";
                clicked => { navkey("no"); }
            }
        }
        HorizontalBox {
            VerticalBox {
                Text {
                    text: "━━ PLAN ━━";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{plan_goals}";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{plan_board}";
                    color: #cdd6f4;
                }
                LineEdit {
                    placeholder-text: "new goal → emits ArchitectureDelta · Enter";
                    accepted(txt) => { plannew(txt); }
                }
                Button {
                    text: "＋ Goal post";
                    clicked => { plannew(""); }
                }
                Text {
                    text: "\{plan_agent}";
                    color: #cdd6f4;
                }
            }
            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) { navkey("up"); return EventResult.accept; }
                    if (event.text == Key.DownArrow) { navkey("down"); return EventResult.accept; }
                    if (event.text == Key.Return) { navkey("enter"); return EventResult.accept; }
                    if (event.text == Key.Escape) { navkey("esc"); return EventResult.accept; }
                    return EventResult.reject;
                }
                VerticalBox {
                    Text {
                        text: "━━ CONQUER ━━";
                        color: #cdd6f4;
                    }
                    HorizontalBox {
                        Text {
                            text: "\{t1}";
                            width: 520px;
                            height: 300px;
                            font-family: "monospace";
                            color: #a6e3a1;
                            wrap: no-wrap;
                        }
                        Text {
                            text: "\{t2}";
                            width: 520px;
                            height: 300px;
                            font-family: "monospace";
                            color: #a6e3a1;
                            wrap: no-wrap;
                        }
                    }
                    HorizontalBox {
                        Text {
                            text: "\{t3}";
                            width: 520px;
                            height: 300px;
                            font-family: "monospace";
                            color: #a6e3a1;
                            wrap: no-wrap;
                        }
                        Text {
                            text: "\{t4}";
                            width: 520px;
                            height: 300px;
                            font-family: "monospace";
                            color: #a6e3a1;
                            wrap: no-wrap;
                        }
                    }
                    Text {
                        text: "\{gpu_ticker}";
                        color: #cdd6f4;
                    }
                    LineEdit {
                        placeholder-text: "prompt · @2/@3/@4 to dispatch · 'all X' to fan-out · Enter";
                        accepted(txt) => { shell(txt); }
                    }
                    HorizontalBox {
                        Button {
                            text: "🤖 Delegate";
                            clicked => { upload(""); }
                        }
                        Button {
                            text: "🔀 Fan-out";
                            clicked => { download(""); }
                        }
                        Button {
                            text: "🧬 Relay";
                            clicked => { relay(""); }
                        }
                        Button {
                            text: "🩺 Heal";
                            clicked => { heal(""); }
                        }
                        Button {
                            text: "💾 Snapshot";
                            clicked => { snapshot(""); }
                        }
                    }
                }
            }
            if master : VerticalBox {
                Text {
                    text: "━━ MASTER ━━";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{m_chains}";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{m_boxes}";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{m_agents}";
                    color: #cdd6f4;
                }
                Text {
                    text: "\{m_gate}";
                    color: #cdd6f4;
                }
                Button {
                    text: "🚀 Deploy";
                    clicked => { deploy(""); }
                }
                Button {
                    text: "⏸ Pause all";
                    clicked => { pause(""); }
                }
                Text {
                    text: "🔑 CLAUDE AUTH";
                    color: #cdd6f4;
                }
                LineEdit {
                    placeholder-text: "paste OAuth token · claude setup-token · Enter";
                    accepted(txt) => { login(txt); }
                }
                Button {
                    text: "🔑 Re-login all";
                    clicked => { login(""); }
                }
                Button {
                    text: "🔓 Clear + fresh login";
                    clicked => { freshlogin(""); }
                }
            }
        }
        HorizontalBox {
            Text {
                text: "\{status}";
                color: #cdd6f4;
            }
            Text {
                text: "\{ticker}";
                color: #cdd6f4;
            }
            Text {
                text: "· PLAN · CONQUER · MASTER · ▶ Pulse · ☰ MASTER · auto-yes 🏛️ gov-only 🔒 no real money · v0.13.0";
