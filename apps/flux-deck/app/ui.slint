// Generated by flux-fcx from FluxDeck.fcx — do not edit by hand.
import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component FluxDeck inherits Window {
    title: "FluxDeck";
    preferred-width: 460px;
