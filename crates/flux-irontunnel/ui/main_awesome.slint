import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, CheckBox, ScrollView, ListView, TabWidget, ProgressIndicator, GroupBox, StandardButton, TextEdit, Slider } from "std-widgets.slint";

export struct ServerInfo {
    id: string,
    name: string,
    country: string,
    city: string,
    load: int,
    ping: int,
}

export struct ConnectionStats {
    download_speed: string,
    upload_speed: string,
    ping: string,
    data_transferred: string,
    connection_time: string,
}

// Custom awesome button component
component AwesomeButton inherits Rectangle {
    in property <string> text;
    in property <color> bg-color: #00d4ff;
    in property <color> hover-color: #00b8e6;
    in property <bool> enabled: true;
    callback clicked;
    
    background: ta.pressed ? hover-color.darker(20%) : ta.has-hover ? hover-color : bg-color;
    border-radius: 12px;
    height: 50px;
    
    animate background { duration: 200ms; easing: ease-in-out; }
    
    TouchArea {
        ta := TouchArea {
            clicked => { if (parent.enabled) { parent.clicked(); } }
        }
    }
    
    Text {
        text: parent.text;
        color: white;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    // Glow effect
    Rectangle {
        background: @radial-gradient(circle, rgba(0, 212, 255, 0.3) 0%, transparent 70%);
        border-radius: 12px;
        opacity: ta.has-hover ? 1 : 0;
        animate opacity { duration: 300ms; }
    }
}

// Status indicator component
component StatusIndicator inherits Rectangle {
    in property <bool> active: false;
    in property <string> label;
    
    width: 120px;
    height: 40px;
    background: active ? #00ff88 : #ff4757;
    border-radius: 20px;
    
    animate background { duration: 300ms; }
    
    HorizontalBox {
        alignment: center;
        
        Rectangle {
            width: 12px;
            height: 12px;
            background: white;
            border-radius: 6px;
            
            animate background { duration: 500ms; }
        }
        
        Text {
            text: label;
            color: white;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

// Cyber-style card component
component CyberCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <color> accent-color: #00d4ff;
    
    background: @linear-gradient(135deg, #1e293b 0%, #334155 100%);
    border-radius: 16px;
    border-width: 2px;
    border-color: accent-color;
    
    VerticalBox {
        padding: 16px;
        alignment: center;
        
        Text {
            text: title;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
        }
        
        Text {
            text: value;
            color: accent-color;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
    
    // Animated border glow
    Rectangle {
        border-width: 1px;
        border-color: @linear-gradient(45deg, transparent 0%, accent-color 50%, transparent 100%);
        border-radius: 16px;
        opacity: 0.6;
        
        animate border-color { duration: 2s; easing: ease-in-out; }
    }
}

